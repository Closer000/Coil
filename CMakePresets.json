{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 18 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{COIL_VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "$env{COIL_VCPKG_ROOT}/installed/x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    }
  ] 
}
